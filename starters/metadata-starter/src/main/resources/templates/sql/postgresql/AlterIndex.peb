{#
Template: AlterIndex.peb
Root:
- model: ModelDdlCtx

Used model fields:
- tableName
- label
- createdIndexes
- deletedIndexes
- updatedIndexes
- renamedIndexes

Used index fields:
- indexName
- oldIndexName
- columns
- unique
- method

Notes:
- updatedIndexes means the index name is unchanged and the latest definition should replace it.
- renamedIndexes means the index name changed and oldIndexName is available.
- Current MySQL behavior renders both update and rename as DROP INDEX + ADD INDEX.
- Pure deleted indexes also generate SQL.
- index.method renders the physical shape: SEARCH -> trigram GIN (pg_trgm is provisioned
  by DdlOrchestrator before execution), PREFIX -> text_pattern_ops B-tree, anything else
  (BTREE, or a ctx built without the field) -> plain index. SEARCH/PREFIX are single-column
  and non-unique by parser validation. The three CREATE sites must stay identical.
#}
/* Table indexes for model: {{ model.label }} */
{% for index in model.deletedIndexes -%}
DROP INDEX {{ index.indexName }};
{% endfor -%}
{% for index in model.createdIndexes -%}
{% if index.method == "SEARCH" -%}
CREATE INDEX {{ index.indexName }} ON {{ model.tableName }} USING gin ({{ index.columns[0] }} gin_trgm_ops);
{% elseif index.method == "PREFIX" -%}
CREATE INDEX {{ index.indexName }} ON {{ model.tableName }} ({{ index.columns[0] }} text_pattern_ops);
{% else -%}
CREATE {% if index.unique %}UNIQUE {% endif -%}
INDEX {{ index.indexName }} ON {{ model.tableName }} ({{ index.columns | join(', ') }});
{% endif -%}
{% endfor -%}
{% for index in model.updatedIndexes -%}
DROP INDEX {{ index.indexName }};
{% if index.method == "SEARCH" -%}
CREATE INDEX {{ index.indexName }} ON {{ model.tableName }} USING gin ({{ index.columns[0] }} gin_trgm_ops);
{% elseif index.method == "PREFIX" -%}
CREATE INDEX {{ index.indexName }} ON {{ model.tableName }} ({{ index.columns[0] }} text_pattern_ops);
{% else -%}
CREATE {% if index.unique %}UNIQUE {% endif -%}
INDEX {{ index.indexName }} ON {{ model.tableName }} ({{ index.columns | join(', ') }});
{% endif -%}
{% endfor -%}
{% for index in model.renamedIndexes -%}
{% if index.definitionChanged -%}
DROP INDEX {{ index.oldIndexName }};
{% if index.method == "SEARCH" -%}
CREATE INDEX {{ index.indexName }} ON {{ model.tableName }} USING gin ({{ index.columns[0] }} gin_trgm_ops);
{% elseif index.method == "PREFIX" -%}
CREATE INDEX {{ index.indexName }} ON {{ model.tableName }} ({{ index.columns[0] }} text_pattern_ops);
{% else -%}
CREATE {% if index.unique %}UNIQUE {% endif -%}
INDEX {{ index.indexName }} ON {{ model.tableName }} ({{ index.columns | join(', ') }});
{% endif -%}
{% else -%}
ALTER INDEX {{ index.oldIndexName }} RENAME TO {{ index.indexName }};
{% endif -%}
{% endfor -%}
